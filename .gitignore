# Node / frontend
node_modules/
dist/
dist-ssr/
*.local

# holds the Firebase config. The glob rather than the three names, because
# Vite also reads .env.production and .env.development and those were not
# covered.
.env*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Vercel
.vercel

# Editors and OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.swp

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# TypeScript build info
*.tsbuildinfo

# Firebase service account keys. These bypass every security rule, so they
# never belong in the repository.
serviceAccountKey*.json
*-firebase-adminsdk-*.json
.firebase/

# Which Firebase project you are pointed at. Made by `firebase use --add`,
# and it is yours rather than the project's.
.firebaserc

# Local working notes. Never pushed: planning docs stay off GitHub.
# *.local above does not match *.local.md, which is how the checklist nearly
# got committed. The glob covers any future one.
*.local.md
