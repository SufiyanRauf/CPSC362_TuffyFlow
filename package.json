{
  "name": "tuffy-flow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "seed": "node db/seed_firestore.mjs",
    "test:rules": "firebase emulators:exec --only firestore \"node --test tests/firestore_rules.test.mjs\"",
    "test:dates": "node --test tests/event_dates.test.mjs"
  },
  "dependencies": {
    "firebase": "^13.1.0",
    "leaflet": "^1.9.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.12",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "firebase-admin": "^14.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
