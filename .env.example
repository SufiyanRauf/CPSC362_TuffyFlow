# Copy this file to .env and fill it in. Never commit .env itself.
# Restart the dev server after any change here, or the new values are ignored.
#
# Anything starting with VITE_ is compiled into the JavaScript that ships to the
# browser. That is fine for the two Supabase values below and NOT fine for any
# other key. If you ever find yourself typing VITE_SUPABASE_SERVICE_KEY, stop:
# that key bypasses all your security rules and this file would publish it.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Week 2 only. These sign the app in as one demo account so your queries return
# rows before the real login screen exists in week 3. Delete both lines, and the
# code that reads them, when you build real login.
#
# These also have to be set in your Vercel project settings, or the deployed site
# is logged out and every card is empty at presentation one.
VITE_DEMO_EMAIL=
VITE_DEMO_PASSWORD=
