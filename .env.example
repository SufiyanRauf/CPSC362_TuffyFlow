# Copy to .env and fill in. Do not commit .env.
# Restart the dev server after changing anything here, Vite only reads it at startup.
# Anything starting with VITE_ ends up in the browser bundle, so only put public
# values here. Never the service role key.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Week 2 only, signs the app in as the demo account so queries return rows before
# the login screen exists. Also needs setting in Vercel. Remove these once auth is built.
VITE_DEMO_EMAIL=
VITE_DEMO_PASSWORD=
