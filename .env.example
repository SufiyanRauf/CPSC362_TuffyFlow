# Copy to .env and fill in. Do not commit .env.
# Restart the dev server after changing anything here, Vite only reads it at startup.
#
# All four of these belong in the browser bundle, and Firebase's own
# documentation says so: none of them is a secret. They name the project, they
# do not grant anything. What decides who may read and write what is
# db/firestore.rules, which runs on Google's side where nobody can edit it.
#
# The one real secret in this project is the service account key the seed
# script wants. That bypasses every rule, so it never goes here, never goes in
# the repository, and .gitignore already covers the usual names.
#
# Find all four in the Firebase console under Project settings, General, in
# the "Your apps" section, after adding a Web app.
#
# Leave them empty and the app still runs: it serves the sample campus bundled
# in src/lib/campusRows.ts, View demo works, and the login screen says why
# signing in is unavailable. Set them in Vercel as well as here, or the
# deployed copy stays on the sample data.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
